<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.0//EN"
        "http://google-web-toolkit.googlecode.com/svn/releases/2.0/distrib/dtd/module-2.0.dtd">
<!--
    GWT module for SuperDev (code-server) development mode.
    Inherits everything from GdxDefinition but disables obfuscation and
    enables source maps for in-browser debugging.
-->
<module rename-to="shatteredpd">

    <inherits name='com.shatteredpixel.shatteredpixeldungeon.GdxDefinition' />

    <!-- Keep pretty names for easier debugging in SuperDev mode -->
    <set-property name="compiler.useSourceMaps" value="true" />
    <collapse-all-properties />

</module>
