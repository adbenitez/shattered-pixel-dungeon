<?xml version="1.0" encoding="UTF-8"?>
<!--
    Main GWT module for Shattered Pixel Dungeon HTML5 build.

    rename-to controls the output directory name for the compiled JavaScript bundle.
    The generated file will be at:  shatteredpd/shatteredpd.nocache.js
-->
<module rename-to="shatteredpd">

    <!-- libGDX GWT backend (provides the WebGL renderer, audio, input, etc.) -->
    <inherits name='com.badlogic.gdx.backends.gdx_backends_gwt' />

    <!-- libGDX controllers GWT backend -->
    <inherits name='com.badlogic.gdx.controllers.controllers-gwt' />

    <!-- Watabou engine classes (SPD-classes module) -->
    <inherits name='com.watabou.SPDClasses' />

    <!-- Core game module -->
    <inherits name='com.shatteredpixel.shatteredpixeldungeon.Core' />

    <!-- Base service interfaces -->
    <inherits name='com.shatteredpixel.shatteredpixeldungeon.services.Services' />

    <!-- HTML launcher (entry point) and HTML platform support -->
    <source path="html" />

    <!-- HTML-specific service implementations (UpdateImpl, NewsImpl) -->
    <source path="services" />

    <!--
        Super-source: GWT-compatible replacements for non-GWT-compatible
        library classes (org.json, FreeTypeFontGenerator stub).
        Files here are treated as if they were at the root of the source tree
        and override classes from the regular classpath.
    -->
    <super-source path="super" />

    <!-- GWT entry point -->
    <entry-point class='com.shatteredpixel.shatteredpixeldungeon.html.HtmlLauncher' />

    <!--
        Path to the game assets directory, relative to the html module root.
        These assets are served alongside the compiled JavaScript.
    -->
    <set-configuration-property name="gdx.assetpath" value="../core/src/main/assets" />

    <!--
        No gdx.reflect.include entries are needed.

        com.watabou.utils.Reflection is replaced by a GWT super-source stub
        (html/src/main/java/.../super/com/watabou/utils/Reflection.java) that
        returns null/false for every operation.  libGDX's IReflectionCache2Generated
        is never generated, so the JVM 65 536-entry constant-pool limit is never hit.

        The HTML build does not use the Bundle serialization system for saving
        game state; a JavaScript/localStorage solution is used instead.
    -->

</module>
